{
  "name": "@pegasusheavy/eslint-typescript-access",
  "version": "1.0.0",
  "description": "ESLint plugin that enforces explicit access modifiers on TypeScript class members",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "typescript",
    "access-modifiers"
  ],
  "author": "Pegasus Heavy Industries LLC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pegasusheavy/eslint-typescript-access.git"
  },
  "bugs": {
    "url": "https://github.com/pegasusheavy/eslint-typescript-access/issues"
  },
  "homepage": "https://pegasusheavy.github.io/eslint-typescript-access/",
  "packageManager": "pnpm@10.20.0",
  "peerDependencies": {
    "@typescript-eslint/utils": "^8.0.0",
    "eslint": "^9.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@typescript-eslint/rule-tester": "^8.18.1",
    "@typescript-eslint/utils": "^8.18.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import-x": "^4.6.1",
    "eslint-plugin-unicorn": "^56.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
